import numpy as np
import os
import pandas as pd
from PIL import Image

# Replace with actual path where you unzipped the dataset
dataset_dir = "/kaggle/working/rare-skin-classifier/data/dermamnist"

# Load CSV files
train_csv = pd.read_csv(os.path.join(dataset_dir, "train.csv"))
val_csv = pd.read_csv(os.path.join(dataset_dir, "val.csv"))
test_csv = pd.read_csv(os.path.join(dataset_dir, "test.csv"))

# Load images and labels
def load_data(df):
    images = []
    labels = []
    for i in range(len(df)):
        img_path = os.path.join(dataset_dir, "images", df.iloc[i]['image_id'] + ".png")
        img = Image.open(img_path).convert("RGB").resize((28, 28))
        images.append(np.array(img))
        labels.append(df.iloc[i]['label'])
    return np.array(images), np.array(labels)

train_images, train_labels = load_data(train_csv)
val_images, val_labels = load_data(val_csv)
test_images, test_labels = load_data(test_csv)

# Save as .npz
np.savez_compressed(os.path.join(dataset_dir, "dermamnist.npz"),
    train_images=train_images,
    train_labels=train_labels,
    val_images=val_images,
    val_labels=val_labels,
    test_images=test_images,
    test_labels=test_labels,
)

print("✅ dermamnist.npz created successfully!")
